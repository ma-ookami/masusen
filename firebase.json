{
  "hosting": {
    "public": ".",
    "ignore": [
      ".git",
      ".git/**",
      "**/.git/**",
      "firebase.json",
      ".firebaserc",
      "firestore.rules",
      "README.md",
      "OVERVIEW.md",
      ".gitignore",
      "**/.*",
      "**/node_modules/**",
      "images",
      "images/**"
    ],
    "cleanUrls": true,
    "headers": [
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/firebase-config.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/*.@(png|webmanifest)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          }
        ]
      }
    ]
  }
}
